//---- [LOGIC] ----/
// Демо словарей map<K, V> — литерал ["ключ": значение, ...]

app_entry {
    // с явным типом: map<строка, число>
    let map<string, u32> prices = ["тыква": 50, "огурец": 90];

    // словарь строк
    let map<string, string> caps = ["греция": "Афины", "египет": "Каир"];

    // доступ по ключу
    print("тыква = ", prices["тыква"]);
    print("столица = ", caps["египет"]);
}
