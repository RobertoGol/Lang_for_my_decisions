// тест: кириллические имена переменных, функций, структур
fn двойня(х: u32) -> u32 { return х * 2; }
fn сложи(а: u32, б: u32) -> u32 { return а + б; }

struct Точка { х: u32; у: u32; }

app_entry {
    let сломано = 21;
    const предел = 100;
    print("двойня:", двойня(сломано));

    let точка = Точка { х: 5, у: 7 };
    print("точка:", сложи(точка.х, точка.у), "предел:", предел);
}
