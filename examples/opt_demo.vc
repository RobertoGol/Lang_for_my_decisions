//---- [LOGIC] ----/
// Тест оптимизатора: всё, что ниже, компилятор должен убрать/свернуть сам.

import "util.ctos";

fn demo_opt() -> u32 {
    let u32 live = 0;
    let tmp = 99;          // мёртвый код: не читается
    5 * 5;                 // мёртвый код: выражение без эффекта
    live = live + 1;
    return live + 2 * 3;   // свёртка: 2 * 3 -> 6
}

app_entry {
    const B = 10 / 3;      // свёртка -> 3
    let u32 a = B + (2 * (3 + 4)); // свёртка внутри

    if (1 < 2) {           // условие всегда «истина»
        a = a + 1;
    } else {
        a = a - 100;       // ветка «else» недостижима
    }

    decide (2 + 3) {       // decide по константе 5
        weight(3) => { print(11); }
        weight(5) => { print(greet("мир")); }
        else      => { print(33); }
    }

    print(demo_opt());
}
