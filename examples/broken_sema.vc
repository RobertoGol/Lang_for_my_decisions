struct Point {
    x: u32;
    y: u32;
}

fn add(a: u32, b: u32) -> u32 {
    return a + b;
}

app_entry {
    let u32 count = 50;
    cont = 5;
    let u32 name = "имя-человека";
    add(1);
    let Point p = Point { x: 1, y: 2 };
    p.z = 3;
    decide (count) {
        weight(10) => { count = 20; }
    }
}
