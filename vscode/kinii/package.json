{
    "name": "kinii-language",
    "displayName": "KINII Language",
    "description": "Язык KINII (VOID-Core v3): подсветка синтаксиса, сниппеты, диагностика kinic (LSP)",
    "version": "0.3.0",
    "publisher": "kinii",
    "license": "MIT",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": ["Programming Languages"],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:kinii",
        "onCommand:kinii.restartServer",
        "onCommand:kinii.fmt",
        "onCommand:kinii.softHints"
    ],
    "contributes": {
        "languages": [
            {
                "id": "kinii",
                "aliases": ["KINII", "kinii"],
                "extensions": [".vc", ".ctos"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "kinii",
                "scopeName": "source.kinii",
                "path": "./syntaxes/kinii.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "kinii",
                "path": "./snippets/kinii.json"
            }
        ],
        "commands": [
            {
                "command": "kinii.restartServer",
                "title": "KINII: перезапустить сервер kinic",
                "category": "KINII"
            },
            {
                "command": "kinii.fmt",
                "title": "KINII: отформатировать файл",
                "category": "KINII"
            },
            {
                "command": "kinii.softHints",
                "title": "KINII: мягкие подсказки — подтверждение Tab/клик (Enter печатает)",
                "category": "KINII"
            }
        ],
        "keybindings": [
            {
                "_note": "Tab принимает выделенную подсказку, но ТОЛЬКО пока открыто меню; вне меню Tab остаётся обычным отступом. Вешаем в расширении, потому что глобальный Tab перехвачен (например, Continue-расширением).",
                "command": "acceptSelectedSuggestion",
                "key": "tab",
                "when": "suggestWidgetVisible"
            }
        ],
        "configuration": {
            "title": "KINII",
            "properties": {
                "kinii.serverPath": {
                    "type": "string",
                    "default": "compiler/build/kinic.exe",
                    "description": "Путь к kinic (абсолютный или от корня рабочей папки). Сервер проверяет код командой 'kinic lsp'."
                },
                "kinii.hints": {
                    "type": "boolean",
                    "default": true,
                    "description": "Мягкое меню-подсказки во время набора (галерея примеров команд). Подсказку можно игнорировать и просто продолжать печатать; принять — Tab или мышкой."
                }
            }
        }
    }
}
